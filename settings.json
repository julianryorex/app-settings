{
    // --- Editor ---
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.minimap.enabled": true,
    // --- Diff editor ---
    "diffEditor.ignoreTrimWhitespace": false,
    // --- Files ---
    "files.exclude": {
        "**/__pycache__": true
    },
    // --- Security ---
    "security.workspace.trust.untrustedFiles": "open",
    // --- Terminal ---
    "terminal.integrated.scrollback": 10000,
    // --- Language-specific ---
    "[css]": {
        "editor.defaultFormatter": "vscode.css-language-features"
    },
    "[dart]": {
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "editor.rulers": [
            80
        ],
        "editor.selectionHighlight": false,
        "editor.suggest.snippetsPreventQuickSuggestions": false,
        "editor.suggestSelection": "first",
        "editor.tabCompletion": "onlySnippets",
        "editor.wordBasedSuggestions": "off"
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    // --- Dart / Flutter ---
    "dart.debugExternalPackageLibraries": false,
    "dart.debugSdkLibraries": false,
    "dart.runPubGetOnPubspecChanges": "never",
    "flutter-coverage.sufficientCoverageThreshold": 80,
    // --- Python extension ---
    "python.createEnvironment.trigger": "off",
    "python.experiments.enabled": false,
    // --- Workbench ---
    "workbench.activityBar.orientation": "vertical",
    "workbench.colorTheme": "Atom One Dark",
    "workbench.editor.pinnedTabsOnSeparateRow": true,
    "workbench.iconTheme": "vscode-icons",
    // --- Git ---
    "git.confirmSync": false,
    "git.openRepositoryInParentFolders": "never",
    "git.replaceTagsWhenPull": true,
    // --- Cursor ---
    "cursor.composer.shouldChimeAfterChatFinishes": true,
    "cursor.preferNotificationsSameAsChat": true,
    // --- Other extensions ---
    "atomKeymap.promptV3Features": true,
    "coverage-gutters.showLineCoverage": true,
    "hediet.vscode-drawio.resizeImages": null,
    "hediet.vscode-drawio.theme": "min",
    "lldb.suppressUpdateNotifications": true,
    "makefile.buildBeforeLaunch": false,
    "makefile.configureAfterCommand": false,
    "makefile.configureOnEdit": false,
    "makefile.configureOnOpen": false,
    "nrf-connect.enableTelemetry": false,
    "vsicons.dontShowNewVersionMessage": true
}

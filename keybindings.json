// Place your key bindings in this file to override the defaults
[
  {
    "key": "ctrl+k",
    "command": "cursorai.action.generateInTerminal",
    "when": "terminalFocus && terminalHasBeenCreated || terminalFocus && terminalProcessSupported"
  },

  {
    "key": "ctrl+shift+alt+cmd+a",
    "command": "workbench.action.maximizeChatSize",
    "when": "cursor.agentIdeUnification.enabled"
  },
  {
    "key": "cmd+;",
    "command": "workbench.action.toggleAuxiliaryBar",
    "when": "!isAuxiliaryWindowFocusedContext"
  },
  {
    "key": "cmd+i",
    "command": "composerMode.agent"
  },
  {
    "key": "cmd+l",
    "command": "composerMode.chat"
  },
  {
    "key": "ctrl+shift+alt+cmd+p",
    "command": "composerMode.plan"
  },
    {
    "key": "ctrl+shift+alt+cmd+\\",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.toggleSidebarVisibility",
        "workbench.action.toggleAuxiliaryBar"
      ]
    }
  },
  {
    "key": "ctrl+shift+alt+cmd+o",
    "command": "-markdown-preview-enhanced.openPreviewToTheSide",
    "when": "editorLangId == 'markdown'"
  }

]
